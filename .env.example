# Copy to .env for local dev. On Railway, set these in the service "Variables" tab.

NODE_ENV=production
PORT=5000

# Used to sign auth tokens. Set a long random value on Railway.
JWT_SECRET=your-secret-key-change-in-production-12345

# Admin account is auto-created on startup from these values.
# Change the password before going live.
ADMIN_EMAIL=arjun@psychiatry.health
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=Arjun Mahadevan

# Optional: path to the SQLite database file.
# For persistent data on Railway, attach a Volume (e.g. mounted at /data)
# and set DB_PATH=/data/shiftswap.db. Leave unset for local dev.
# DB_PATH=/data/shiftswap.db
